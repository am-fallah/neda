# Neda configuration — placeholders only.
# These are development defaults. For a Docker Compose deployment, use
# scripts/setup.sh instead; compose.yaml overrides NEDA_ENV, DB, key, and host
# paths. Do not commit real secrets. Production requires an owner-only key file
# and a public origin. That origin may be HTTPS or, only with the explicit
# NEDA_ALLOW_INSECURE_HTTP opt-in below, HTTP using an IP literal.
NEDA_ENV=development
# Direct binary/listen address. Use 0.0.0.0:PORT when exposing Neda directly.
NEDA_HTTP_ADDR=:8080
NEDA_DB_PATH=./data/neda.db
NEDA_ENCRYPTION_KEY_FILE=
# Public origin used for Host/Origin validation and generated links. For direct
# HTTP access, set this to http://SERVER_PUBLIC_IP:PORT and enable the opt-in.
NEDA_PUBLIC_URL=
NEDA_VAPID_SUBJECT=
NEDA_LOG_LEVEL=info
NEDA_LOG_FORMAT=text
NEDA_TRUST_PROXY=false
# Set true only for direct, unencrypted HTTP access by IP. Production HTTP is
# rejected unless this is true; HTTPS origins never need it. This disables
# Secure cookies and HSTS. Direct HTTP is unsuitable for sensitive networks
# unless protected by a VPN or other secure transport.
NEDA_ALLOW_INSECURE_HTTP=false
# Required in production and must be set explicitly for Compose. Development
# registers MrBilit automatically.
NEDA_MRBILIT_ENABLED=true
# Test-only fake provider; never a real ticket source and rejected in production.
NEDA_FAKE_PROVIDER_ENABLED=false
NEDA_SESSION_TTL_HOURS=720
NEDA_SESSION_IDLE_HOURS=168
NEDA_WORKERS=2

# Docker Compose only: host interface and port used to publish Neda. Keep
# 127.0.0.1 for reverse-proxy mode; use 0.0.0.0 only for direct external access.
NEDA_PUBLISH_HOST=127.0.0.1
NEDA_PUBLISH_PORT=8080

# Docker Compose only: run as the owner of ./data and the key secret.
NEDA_RUNTIME_UID=1000
NEDA_RUNTIME_GID=1000

# Direct HTTP example (unencrypted; set all four values):
# NEDA_PUBLIC_URL=http://203.0.113.10:8080
# NEDA_ALLOW_INSECURE_HTTP=true
# NEDA_PUBLISH_HOST=0.0.0.0
# NEDA_PUBLISH_PORT=8080
