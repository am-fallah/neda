# Neda configuration — placeholders only.
# Do not commit real secrets. Production requires an owner-only key file and
# an HTTPS public URL; see docs/ARCHITECTURE.md §6.
NEDA_ENV=development
NEDA_HTTP_ADDR=:8080
NEDA_DB_PATH=./data/neda.db
NEDA_ENCRYPTION_KEY_FILE=
NEDA_PUBLIC_URL=
NEDA_VAPID_SUBJECT=
NEDA_LOG_LEVEL=info
NEDA_LOG_FORMAT=text
NEDA_TRUST_PROXY=false
# Test-only fake provider; never a real ticket source.
NEDA_FAKE_PROVIDER_ENABLED=false
NEDA_SESSION_TTL_HOURS=720
NEDA_SESSION_IDLE_HOURS=168
NEDA_WORKERS=2
